diff --git a/arch/riscv/kernel/qpu.c b/arch/riscv/kernel/qpu.c
new file mode 100644
index 000000000..38180503a
--- /dev/null
+++ b/arch/riscv/kernel/qpu.c
@@ -0,0 +1,350 @@
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/percpu.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <asm/ptrace.h>
+#include <asm/qpu.h>
+#include <asm/csr.h>
+#include <asm/vendor_extensions.h>
+#include <asm/vendor_extensions/qpu.h>
+
+#define RISCV_QPU_INSTR(funct7) "0b0101011, 1, " funct7
+
+static DEFINE_PER_CPU(struct task_struct *, qpu_cpu_owner);
+
+/* -------------------------------------------------------------------------- */
+/* Instruction/backend stubs.  Replace these with your real emulator API.      */
+
+bool __weak riscv_qpu_insn_is_qpu(u32 insn)
+{
+	// compare opcode + funct3
+	const u32 insn_mask = 0x707f;
+	const u32 insn_compare = 0x102b;
+
+	// TODO: implement valid funct7 checking
+	return (insn & insn_mask) == insn_compare;
+}
+
+size_t __weak riscv_qpu_arch_state_size(void)
+{
+	/*
+	 * Stub: return the number of bytes required for a saved QPU context.
+	 * Return 0 if all state is host-side and addressed by context_id.
+	 */
+	return 0;
+}
+
+int __weak riscv_qpu_arch_alloc_context(struct __riscv_qpu_ext_state *state)
+{
+	unsigned long new_context_id;
+	asm volatile (
+	    ".insn r " RISCV_QPU_INSTR("1") ", %0, x0, x0"
+	    : "=r"(new_context_id)
+	);
+	state->context_id = new_context_id;
+	return 0;
+}
+
+void __weak riscv_qpu_arch_free_context(struct __riscv_qpu_ext_state *state)
+{
+	unsigned long context_id = state->context_id;
+	asm volatile (
+	    ".insn r " RISCV_QPU_INSTR("2") ", x0, %0, x0"
+	    : : "r"(context_id)
+	);
+}
+
+int __weak riscv_qpu_arch_init_context(struct __riscv_qpu_ext_state *state)
+{
+	/* Stub: initialize/reset context_id to the architectural initial state. */
+	return 0;
+}
+
+int __weak riscv_qpu_arch_save_context(struct __riscv_qpu_ext_state *state)
+{
+	/* Stub: serialize current hardware/emulator state into state->datap. */
+	return 0;
+}
+
+int __weak riscv_qpu_arch_restore_context(struct __riscv_qpu_ext_state *state)
+{
+	/* Stub: load state->datap or bind host-side state->context_id. */
+	return 0;
+}
+
+int __weak riscv_qpu_arch_clone_context(struct __riscv_qpu_ext_state *dst,
+					struct __riscv_qpu_ext_state *src)
+{
+	/* Stub: clone host-side src->context_id into dst->context_id, if needed. */
+	return 0;
+}
+
+bool __weak riscv_qpu_arch_hw_dirty(void)
+{
+	/* Stub: read an emulator dirty bit or status CSR. */
+	return false;
+}
+
+int riscv_qpu_arch_enable_context(struct __riscv_qpu_ext_state *state)
+{
+	csr_write(CSR_QPU_CTX, state->context_id);
+	return 0;
+}
+
+void riscv_qpu_arch_disable(void)
+{
+	csr_write(CSR_QPU_CTX, 0);
+}
+
+static bool riscv_qpu_arch_enabled(void)
+{
+	return csr_read(CSR_QPU_CTX) != 0;
+}
+
+/* -------------------------------------------------------------------------- */
+
+static int qpu_alloc_state(struct __riscv_qpu_ext_state *state)
+{
+	size_t size;
+	int ret;
+
+	memset(state, 0, sizeof(*state));
+
+	size = riscv_qpu_arch_state_size();
+	if (size) {
+		state->datap = kzalloc(size, GFP_KERNEL);
+		if (!state->datap)
+			return -ENOMEM;
+		state->size = size;
+	}
+
+	ret = riscv_qpu_arch_alloc_context(state);
+	if (ret) {
+		kfree(state->datap);
+		memset(state, 0, sizeof(*state));
+		return ret;
+	}
+
+	state->status = RISCV_QPU_INITIAL;
+	state->flags = RISCV_QPU_THREAD_USED;
+	return 0;
+}
+
+static void qpu_free_state(struct __riscv_qpu_ext_state *state)
+{
+	if (!(state->flags & RISCV_QPU_THREAD_USED))
+		return;
+
+	riscv_qpu_arch_free_context(state);
+	kfree(state->datap);
+	memset(state, 0, sizeof(*state));
+}
+
+static int qpu_ensure_state(struct task_struct *tsk)
+{
+	if (tsk->thread.qpu.flags & RISCV_QPU_THREAD_USED)
+		return 0;
+
+	return qpu_alloc_state(&tsk->thread.qpu);
+}
+
+static void qpu_disable_cpu(void)
+{
+	riscv_qpu_arch_disable();
+	this_cpu_write(qpu_cpu_owner, NULL);
+}
+
+static int qpu_save_owner(struct task_struct *tsk)
+{
+	struct __riscv_qpu_ext_state *state = &tsk->thread.qpu;
+	int ret;
+
+	if (!(state->flags & RISCV_QPU_THREAD_USED))
+		return 0;
+
+	if (this_cpu_read(qpu_cpu_owner) != tsk)
+		return 0;
+
+	if (!riscv_qpu_arch_hw_dirty()) {
+		state->status = RISCV_QPU_CLEAN;
+		return 0;
+	}
+
+	ret = riscv_qpu_arch_save_context(state);
+	if (ret)
+		return ret;
+
+	state->status = RISCV_QPU_CLEAN;
+	return 0;
+}
+
+static int qpu_restore_current(void)
+{
+	struct __riscv_qpu_ext_state *state = &current->thread.qpu;
+	struct task_struct *owner;
+	int ret;
+
+	owner = this_cpu_read(qpu_cpu_owner);
+	if (owner == current)
+		return 0;
+
+	if (owner) {
+		ret = qpu_save_owner(owner);
+		if (ret)
+			return ret;
+		qpu_disable_cpu();
+	}
+
+	ret = qpu_ensure_state(current);
+	if (ret)
+		return ret;
+
+	if (state->status == RISCV_QPU_INITIAL)
+		ret = riscv_qpu_arch_init_context(state);
+	else
+		ret = riscv_qpu_arch_restore_context(state);
+	if (ret)
+		return ret;
+
+	ret = riscv_qpu_arch_enable_context(state);
+	if (ret)
+		return ret;
+
+	this_cpu_write(qpu_cpu_owner, current);
+	state->status = RISCV_QPU_CLEAN;
+	return 0;
+}
+
+static bool qpu_fetch_faulting_insn(struct pt_regs *regs, u32 *insn)
+{
+	const void __user *uaddr = (const void __user *)regs->epc;
+
+	if (copy_from_user_nofault(insn, uaddr, sizeof(*insn)))
+		return false;
+
+	/* QPU custom instructions are expected to be 32-bit encodings. */
+	if ((*insn & 0x3) != 0x3)
+		return false;
+
+	return true;
+}
+
+static bool qpu_try_reinitialize(void)
+{
+	struct __riscv_qpu_ext_state *state = &current->thread.qpu;
+	if (state->status != RISCV_QPU_OFF &&
+	    state->context_id != 0 &&
+	    !riscv_qpu_arch_enabled()) {
+		riscv_qpu_arch_enable_context(state);
+		return true;
+	}
+	return false;
+}
+
+bool riscv_qpu_first_use_handler(struct pt_regs *regs)
+{
+	u32 insn;
+	int ret;
+
+	if (!riscv_qpu_available())
+		return false;
+
+	if (!user_mode(regs))
+		return false;
+
+	if (!qpu_fetch_faulting_insn(regs, &insn))
+		return false;
+
+	if (!riscv_qpu_insn_is_qpu(insn))
+		return false;
+
+	if (qpu_try_reinitialize())
+		return true;
+
+	ret = qpu_restore_current();
+	if (ret) {
+		force_sig_fault(SIGBUS, BUS_OBJERR, (void __user *)regs->epc);
+		return true;
+	}
+
+	/* Leave regs->epc unchanged.  The QPU instruction will be retried. */
+	return true;
+}
+
+void __switch_to_qpu(struct task_struct *prev, struct task_struct *next)
+{
+	/*
+	 * Lazy restore policy:
+	 *   - save prev if this CPU currently owns its live QPU context,
+	 *   - disable QPU before entering next,
+	 *   - let next trap on first QPU instruction and restore there.
+	 */
+	WARN_ON_ONCE(qpu_save_owner(prev));
+	qpu_disable_cpu();
+}
+
+int riscv_qpu_dup_task_struct(struct task_struct *dst, struct task_struct *src)
+{
+	struct __riscv_qpu_ext_state *s = &src->thread.qpu;
+	struct __riscv_qpu_ext_state *d = &dst->thread.qpu;
+	int ret;
+
+	memset(d, 0, sizeof(*d));
+
+	if (!(s->flags & RISCV_QPU_THREAD_USED))
+		return 0;
+
+	/* If the parent owns live dirty hardware state, materialize it first. */
+	ret = qpu_save_owner(src);
+	if (ret)
+		return ret;
+
+	ret = qpu_alloc_state(d);
+	if (ret)
+		return ret;
+
+	d->status = s->status;
+	if (s->size) {
+		if (d->size != s->size) {
+			qpu_free_state(d);
+			return -EINVAL;
+		}
+		memcpy(d->datap, s->datap, s->size);
+	}
+
+	ret = riscv_qpu_arch_clone_context(d, s);
+	if (ret) {
+		qpu_free_state(d);
+		return ret;
+	}
+
+	return 0;
+}
+
+void riscv_qpu_thread_free(struct task_struct *tsk)
+{
+	if (tsk == current && this_cpu_read(qpu_cpu_owner) == tsk)
+		qpu_disable_cpu();
+	qpu_free_state(&tsk->thread.qpu);
+}
+
+void riscv_qpu_flush_thread(struct task_struct *tsk)
+{
+	if (tsk == current && this_cpu_read(qpu_cpu_owner) == tsk)
+		qpu_disable_cpu();
+	qpu_free_state(&tsk->thread.qpu);
+}
+
+void riscv_qpu_kernel_thread_init(struct task_struct *tsk)
+{
+	qpu_free_state(&tsk->thread.qpu);
+}
+
+bool riscv_qpu_available(void)
+{
+	return riscv_isa_vendor_extension_available(QPU_VENDOR_ID, XQPU);
+}
